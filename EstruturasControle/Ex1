package EstruturasControle;

import java.util.Scanner;

public class Ex1 {

	public static void main(String[] args) {
		
		Scanner leitor = new Scanner(System.in);
		
		System.out.println("Digite o nímero de turmas: ");
		int n = leitor.nextInt();
		
		int [] turmas = new int [n];
		
		for (int i = 0; i < turmas.length; i++) {
			
			do {
				System.out.println("Digite o número de alunos na "+ (i+1)+"é turma:");
				turmas [i] = leitor.nextInt();
				
				if (turmas[i] > 32 || turmas[i] <0) {
					System.out.println("Número indevido. Nenhuma turma deve ter mais de 32 alunos");
				}
			}while (turmas[i] > 32 || turmas[i] <0);
		}
		
		int soma = 0;
		
		for (int i = 0; i < turmas.length; i++) {
			soma += turmas[i];
		}
		
		double media = (double) soma / n;
		
		System.out.println("A média de alunos por turma é: "+media);
		
		leitor.close();
	}

}
